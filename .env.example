APP_ENV=local
LOG_LEVEL=INFO

# local is the default so tests and demos run without starting Neo4j.
GRAPH_BACKEND=local

# Use these when GRAPH_BACKEND=neo4j or when running docker-compose.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=biomed-memory

# rule is default. hf_local loads a local SentenceTransformer model if installed/cached.
EXTRACTION_MODE=rule
HF_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
